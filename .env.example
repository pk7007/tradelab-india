# Copy to .env for local development. Never commit .env or expose these values in a browser.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8765
KITE_API_KEY=replace_with_your_zerodha_developer_app_key
KITE_API_SECRET=replace_with_your_zerodha_developer_app_secret
KITE_REDIRECT_URL=http://127.0.0.1:8765/auth/kite/callback
# Keep disabled until you have reviewed broker/exchange requirements and are ready for live orders.
TRADELAB_ENABLE_LIVE_ORDERS=false

# Enable only after confirming permission for permanent historical-data storage.
KITE_DATA_STORAGE_APPROVED=false
# Optional: TRADELAB_DATA_DIR overrides the private local AppData storage path.
